&НаКлиенте
Процедура Заполнить(Команда)
    ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
    Объект.Начисления.Очистить();
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Д.Ссылка КАК Договор, Д.Контрагент КАК Контрагент, Д.СуммаВМесяц КАК Сумма
    |ИЗ Документ.ДоговорАренды КАК Д
    |ГДЕ Д.Проведен И Д.ДатаНачала <= &Кон
    |  И (Д.ДатаОкончания = ДАТАВРЕМЯ(1,1,1) ИЛИ Д.ДатаОкончания >= &Нач)");
    Запрос.УстановитьПараметр("Нач", НачалоМесяца(Объект.Период));
    Запрос.УстановитьПараметр("Кон", КонецМесяца(Объект.Период));
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗаполнитьЗначенияСвойств(Объект.Начисления.Добавить(), Выборка);
    КонецЦикла;
КонецПроцедуры