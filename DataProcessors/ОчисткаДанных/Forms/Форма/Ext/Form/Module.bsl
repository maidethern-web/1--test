&НаСервере
Функция ТолькоЦифры(Стр)
    Для Сч = 1 По СтрДлина(Стр) Цикл
        Если СтрНайти("0123456789", Сред(Стр, Сч, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат СтрДлина(Стр) > 0;
КонецФункции

&НаСервере
Функция НормализоватьТелефон(ИсходныйНомер)
    Если Не ЗначениеЗаполнено(ИсходныйНомер) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Цифры = "";
    Для Сч = 1 По СтрДлина(ИсходныйНомер) Цикл
        Символ = Сред(ИсходныйНомер, Сч, 1);
        Если СтрНайти("0123456789", Символ) > 0 Тогда
            Цифры = Цифры + Символ;
        КонецЕсли;
    КонецЦикла;
    
    Если СтрДлина(Цифры) = 9 Тогда
        Цифры = "998" + Цифры;
    КонецЕсли;
    
    Если СтрДлина(Цифры) = 12 И Лев(Цифры, 3) = "998" Тогда
        Возврат "+" + Цифры;
    КонецЕсли;
    
    Возврат Неопределено;
КонецФункции

&НаСервере
Функция НайтиДублиКонтрагентов()
    Запрос = Новый Запрос(
    "ВЫБРАТЬ
    |   К.ИНН КАК ИНН,
    |   КОЛИЧЕСТВО(К.Ссылка) КАК Количество
    |ИЗ
    |   Справочник.Контрагенты КАК К
    |ГДЕ
    |   К.ИНН <> """"
    |СГРУППИРОВАТЬ ПО
    |   К.ИНН
    |ИМЕЮЩИЕ
    |   КОЛИЧЕСТВО(К.Ссылка) > 1");
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаКлиенте
Процедура НормализоватьТелефоны(Команда)
    НормализоватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура НормализоватьНаСервере()
    Выборка = Справочники.КонтактныеЛица.Выбрать();
    Пока Выборка.Следующий() Цикл
        НовыйНомер = НормализоватьТелефон(Выборка.Телефон);
        Если НовыйНомер = Неопределено Тогда
            Журнал = Журнал + "Некорректный номер: " + Выборка.Наименование + " (" + Выборка.Телефон + ")" + Символы.ПС;
        ИначеЕсли НовыйНомер <> Выборка.Телефон Тогда
            Об = Выборка.ПолучитьОбъект();
            Об.Телефон = НовыйНомер;
            Об.Записать();
            Журнал = Журнал + Выборка.Телефон + " → " + НовыйНомер + Символы.ПС;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НайтиДубли(Команда)
    НайтиДублиНаСервере();
КонецПроцедуры

&НаСервере
Процедура НайтиДублиНаСервере()
    Для Каждого Стр Из НайтиДублиКонтрагентов() Цикл
        Журнал = Журнал + "Дубль ИНН " + Стр.ИНН + ": " + Стр.Количество + " карточки" + Символы.ПС;
    КонецЦикла;
КонецПроцедуры