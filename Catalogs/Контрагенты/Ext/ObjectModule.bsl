Процедура ПередЗаписью(Отказ)
    Если ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
    Для Каждого Поле Из СтрРазделить("ИНН,ПИНФЛ", ",") Цикл
        Если Не ЗначениеЗаполнено(ЭтотОбъект[Поле]) Тогда Продолжить; КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка ИЗ Справочник.Контрагенты КАК К
        |ГДЕ К." + Поле + " = &Знач И К.Ссылка <> &Ссылка");
        Запрос.УстановитьПараметр("Знач", ЭтотОбъект[Поле]);
        Запрос.УстановитьПараметр("Ссылка", Ссылка);
        Если Не Запрос.Выполнить().Пустой() Тогда
            Сообщить("Контрагент с " + Поле + " " + ЭтотОбъект[Поле] + " уже есть в базе");
            Отказ = Истина;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры